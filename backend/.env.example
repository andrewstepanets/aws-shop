# Copy to .env and fill in. All values are deploy inputs you choose —
# none of them depend on a previously deployed stack, so `npm run build`
# and `cdk deploy --all` work in a single pass from a clean account.

# Resource naming + tags (also used to derive the SSM auth config param name).
PROJECT_NAME=aws-shop
STAGE=dev

# Region all stacks deploy into (Cognito + the SSM auth config param live here).
AWS_REGION=eu-west-1

# Globally-unique prefix for the Cognito Hosted UI domain
# (e.g. https://<prefix>.auth.<region>.amazoncognito.com).
COGNITO_DOMAIN_PREFIX=aws-shop-dev-login
